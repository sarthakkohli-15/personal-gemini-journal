rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128;
    }

    // User Profile matching
    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId)
        && isValidId(userId)
        && request.resource.data.id == userId
        && request.resource.data.email is string;
      allow update: if isOwner(userId)
        && request.resource.data.id == userId;
      allow delete: if isOwner(userId);

      // User's private Journal Entries and Reflections
      match /entries/{entryId} {
        allow read: if isOwner(userId);

        allow create: if isOwner(userId)
          && isValidId(entryId)
          && request.resource.data.userId == userId
          && request.resource.data.title is string
          && request.resource.data.title.size() <= 200
          && request.resource.data.messages is list
          && (!('photos' in request.resource.data) || request.resource.data.photos is list);

        allow update: if isOwner(userId)
          && isValidId(entryId)
          && request.resource.data.userId == userId
          && request.resource.data.title is string
          && request.resource.data.messages is list
          && (!('photos' in request.resource.data) || request.resource.data.photos is list);

        allow delete: if isOwner(userId);
      }

      // User's private Growth Insights
      match /growthInsights/{insightId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId)
          && isValidId(insightId)
          && request.resource.data.userId == userId;
        allow delete: if isOwner(userId);
      }

      // User's private Monthly Reflections
      match /monthlyReflections/{monthId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId)
          && isValidId(monthId)
          && request.resource.data.userId == userId;
        allow delete: if isOwner(userId);
      }
    }

    // Inspiration Space: Explicitly shared, sanitized community stories
    match /publicStories/{storyId} {
      // Authenticated users can browse inspiration stories
      allow read: if isSignedIn();

      // Only the verified author can create their own story
      allow create: if isSignedIn()
        && isValidId(storyId)
        && request.resource.data.authorUid == request.auth.uid
        && request.resource.data.title is string
        && request.resource.data.title.size() <= 200
        && request.resource.data.content is string
        && request.resource.data.content.size() <= 20000
        && request.resource.data.authorDisplayName is string
        && request.resource.data.authorDisplayName.size() <= 100;

      // Only the author can update their story, OR any signed in user can toggle the "Inspired Me" reaction
      allow update: if isSignedIn()
        && (
          // Author modifying their own story (immutable authorUid)
          (request.auth.uid == resource.data.authorUid && request.resource.data.authorUid == resource.data.authorUid)
          ||
          // Community interaction: Only updating reaction fields
          (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['inspiredCount', 'inspiredBy']))
        );

      // Only the author can unpublish (delete) their story
      allow delete: if isSignedIn() && resource.data.authorUid == request.auth.uid;
    }
  }
}
